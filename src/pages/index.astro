---
import SiteLayout from "../components/SiteLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import ProjectCards from "../components/ProjectCards.astro";
import SkillsGrid from "../components/SkillsGrid.astro";
import Credentials from "../components/Credentials.astro";
import { content } from "../data/content";

const c = content.en;
---

<SiteLayout locale="en" c={c}>
  <Header locale="en" c={c} />
  <main id="main">
    <Hero c={c} />
    <ExperienceTimeline c={c} />
    <ProjectCards c={c} />
    <SkillsGrid c={c} />
    <Credentials c={c} />
  </main>
</SiteLayout>
