---
import type { SiteContent } from "../data/content";
import { links, shared } from "../data/content";
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import portrait from "../assets/joaquin-haro-filippon.jpg";

interface Props {
  c: SiteContent;
}

const { c } = Astro.props;
---

<section class="bg-navy text-white">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-hero-eyebrow">
          {c.hero.eyebrow}
        </p>
        <h1 class="mt-4 text-4xl font-bold leading-tight sm:text-5xl">
          {c.hero.title}
        </h1>
        <p class="mt-3 text-lg font-semibold text-white/90">{shared.name}</p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-hero-muted">
          {c.hero.lead}
        </p>
        <p class="mt-4 text-sm font-medium text-hero-eyebrow">{c.hero.availability}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-md bg-blue px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-dark"
          >
            {c.hero.ctaProjects}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a
            href={links.cv}
            download
            class="inline-flex items-center gap-2 rounded-md border border-white/40 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-white"
          >
            <Icon name="download" class="h-4 w-4" />
            {c.hero.ctaCv}
          </a>
        </div>
      </div>

      <div class="mx-auto w-full max-w-[17rem] sm:max-w-xs lg:max-w-sm lg:justify-self-end">
        <Image
          src={portrait}
          alt={`${shared.name} — ${c.hero.title}`}
          widths={[288, 384, 576, 768]}
          sizes="(min-width: 1024px) 24rem, (min-width: 640px) 20rem, 17rem"
          format="webp"
          quality={78}
          loading="eager"
          class="aspect-[4/5] w-full rounded-2xl border border-white/15 object-cover object-top shadow-2xl shadow-black/40"
        />
      </div>
    </div>

    <dl class="mt-14 grid max-w-2xl grid-cols-1 gap-px overflow-hidden rounded-lg border border-white/15 bg-white/15 sm:grid-cols-3">
      {
        c.hero.stats.map((stat) => (
          <div class="flex flex-col bg-navy px-5 py-4">
            <dt class="order-2 text-xs text-hero-muted">{stat.label}</dt>
            <dd class="text-xl font-bold text-white">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
